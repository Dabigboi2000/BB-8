this program is a terminal based clone of the popular game snake
this program for some reason will NOT run if loaded into RAM, and will only run when @0000 (i tried)
*;

#TITL
    LDA $0a PAA
    LDA *- PAA
    LDA *- PAA
    LDA *- PAA
    LDA $20 PAA
    LDA *| PAA
    LDA *\ PAA
    LDA $20 PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA *| PAA
    LDA *- PAA
    LDA *- PAA
    LDA *- PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA */ PAA
    LDA $0a PAA

    LDA *\ PAA
    LDA *_ PAA
    LDA *_ PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA *\ PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA *| PAA
    LDA *_ PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA *| PAA
    LDA */ PAA
    LDA $20 PAA
    LDA $20 PAA
    LDA $20 PAA
    LDA $0a PAA

    LDA *_ PAA
    LDA *_ PAA
    LDA *_ PAA
    LDA */ PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA $20 PAA
    LDA *\ PAA
    LDA *| PAA
    LDA $20 PAA
    LDA $20 PAA
    LDA *| PAA
    LDA *_ PAA
    LDA *_ PAA
    LDA *_ PAA
    LDA $20 PAA
    LDA *| PAA
    LDA $20 PAA
    LDA *\ PAA
    LDA *_ PAA
    LDA $0a PAA

    LDA *- PAA
    LDA *- PAA
    LDA *a PAA
    LDA *n PAA
    LDA *y PAA
    LDA $20 PAA
    LDA *k PAA
    LDA *e PAA
    LDA *y PAA
    LDA $20 PAA
    LDA *t PAA
    LDA *o PAA
    LDA $20 PAA
    LDA *s PAA
    LDA *t PAA
    LDA *a PAA
    LDA *r PAA
    LDA *t PAA
    LDA *- PAA
    LDA *- PAA
    LDA $0a PAA

    LDA $0a PAA

    LDA *p PAA
    LDA *r PAA
    LDA *e PAA
    LDA *s PAA
    LDA *s PAA
    LDA $20 PAA
    LDA *\ PAA
    LDA $20 PAA
    LDA *t PAA
    LDA *o PAA
    LDA $20 PAA
    LDA *e PAA
    LDA *x PAA
    LDA *i PAA
    LDA *t PAA
    LDA $0a PAA

    JMP &BEFOH &BEFOL

#BEFO
    LDF &BEFOH          ;check if key pressed
    LDG &BEFOL
    EX1 JMR

    PDA
    AA0

    LDB *\
    BA1
    LDF $00
    LDG $00
    NEQ JMR

    JMP &PRECH &PRECL

#PREC
    LDE $81 LDD $00     ;reset direction
    LDA $01
    WRA
    
    LDE $81 LDD $01     ;reset x pos
    LDA $05
    WRA
    
    LDE $81 LDD $02     ;reset y pos
    LDA $08
    WRA
    
    LDE $81 LDD $03     ;reset score
    LDA $03
    WRA
    
    LDE $80             ;reset counter
    LDD $00
    JMP &CLEAH &CLEAL   ;jump into loop

#CLEA
    LDE $80
    LDA *.              ;write empty
    WRA

    LDE $82
    LDA $00              ;write empty
    WRA

    DA0
    LDA $FF
    AA1
    LDF &FIRSH          ;check if equal
    LDG &FIRSL
    NEQ JMR

    LDA $01             ;increment
    AA1
    ADD
    ALD
    JMP &CLEAH &CLEAL

#FIRS
    LDE $80 LDD $8b     ;add first apple
    LDA *@
    WRA

    JMP &RESEH &RESEL

#RESE
    LDA $0C             ;clear screen
    PAA
    LDD $00             ;reset counter
    LDE $80
    JMP &TESTH &TESTL   ;jump into loop

#TEST
    RDA PAA             ;print character
    LDA $20 PAA

    DA0
    LDA $FF
    AA1
    LDF &INPUH          ;check if equal
    LDG &INPUL
    NEQ JMR

    LDA $01             ;increment
    AA1
    ADD
    ALD

    LDA $10             ;check for newline
    AA1
    DA0
    MUL
    ALA
    AA0
    LDB $00
    BA1
    LDF &NEWLH          ;check if equal
    LDG &NEWLL
    NEQ JMR
    JMP &TESTH &TESTL

#INPU
    LDF &MOVEH          ;check if key pressed
    LDG &MOVEL
    EX1 JMR

    LDE $81 LDD $00     ;retreive direction
    RDA
    AA0

    PDC
    CA0
    
    LDB *w             ;key w pressed
    BA1
    LDB $00
    NEQ B>A

    LDB *d             ;key d pressed
    BA1
    LDB $01
    NEQ B>A

    LDB *s             ;key s pressed
    BA1
    LDB $02
    NEQ B>A

    LDB *a             ;key a pressed
    BA1
    LDB $03
    NEQ B>A

    WRA                 ;write new direction

    LDB *\             ;key \ pressed
    BA1
    LDF $00
    LDG $00
    NEQ JMR

    JMP &MOVEH &MOVEL   ;move snake
    

#MOVE
    LDE $81 LDD $00     ;retreive direction
    RDA
    AA0

    LDB $00             ;is equal to 0?
    BA1
    LDF &DIRUH
    LDG &DIRUL
    NEQ JMR

    LDB $01             ;is equal to 1?
    BA1
    LDF &DIRRH
    LDG &DIRRL
    NEQ JMR

    LDB $02             ;is equal to 2?
    BA1
    LDF &DIRDH
    LDG &DIRDL
    NEQ JMR

    LDB $03            ;is equal to 3?
    BA1
    LDF &DIRLH
    LDG &DIRLL
    NEQ JMR

    JMP &RESEH &RESEL   ;redraw screen

#NEWL
    LDA $0A
    PAA
    JMP &TESTH &TESTL

#DIRU
    LDE $81 LDD $02     ;retreive y position
    RDA
    AA0
    LDB $01
    BA1
    SUB
    ALA
    
    LDB $FF             ;check for wrap around
    AA0
    BA1
    LDB $0f
    NEQ B>A

    WRA                 ;save new position
    JMP &UPDAH &UPDAL   ;draw new position

#DIRR
    LDE $81 LDD $01     ;retreive x position
    RDA
    AA0
    LDB $01
    BA1
    ADD
    ALA
    
    LDB $10             ;check for wrap around
    AA0
    BA1
    LDB $00
    NEQ B>A

    WRA                 ;save new position
    JMP &UPDAH &UPDAL   ;draw new position

#DIRD
    LDE $81 LDD $02     ;retreive y position
    RDA
    AA0
    LDB $01
    BA1
    ADD
    ALA
    
    LDB $10             ;check for wrap around
    AA0
    BA1
    LDB $00
    NEQ B>A

    WRA                 ;save new position
    JMP &UPDAH &UPDAL   ;draw new position

#DIRL
    LDE $81 LDD $01     ;retreive x position
    RDA
    AA0
    LDB $01
    BA1
    SUB
    ALA

    LDB $ff             ;check for wrap around
    AA0
    BA1
    LDB $0f
    NEQ B>A

    WRA                 ;save new position
    JMP &UPDAH &UPDAL   ;draw new position

#UPDA
    LDE $81 LDD $02     ;retreive y position
    RDA
    LDB $10
    AA0                 ;load into ALU
    BA1
    MUL
    ALA
    AA0
        
    LDE $81 LDD $01     ;retreive x position
    RDB
    BA1                 ;load into ALU
    ADD
    ALA

    LDE $81 LDD $03     ;retreive score
    RDB
    LDC $01             ;calculate new score if apple eaten
    BA0
    CA1
    ADD
    ALC

    LDE $80             ;check if apple eaten
    A>D
    RDA
    LDF *@
    AA0
    FA1
    LDF &PREAH
    LDG &PREAL
    NEQ JMR             ;if apple eaten, update score

    D>A 

    LDF *#              ;check if self collision
    FA1
    LDF &DEADH
    LDG &DEADL
    NEQ JMR

    A>D                 ;write new head into RAM
    LDE $80
    LDA *#
    WRA

    LDE $82
    LDA $FF
    WRA

    JMP &PRETH &PRETL   ;handle tail

#PREA
    C>B
    D>A                 ;write new score
    LDE $81 LDD $03
    WRB

    A>D                 ;write new head into RAM
    LDE $80
    LDA *#
    WRA

    LDE $82
    LDA $FF
    WRA

    JMP &APPLH &APPLL   ;new apple

#APPL
    LDA $04             ;get random number from expansion port
    PBA PBA
    PCD

    LDE $80             ;if is on snake body try again
    RDA
    AA0
    LDB *#
    BA1
    LDF &APPLH
    LDG &APPLL
    NEQ JMR

    LDA *@
    WRA
    JMP &PRETH &PRETL   ;handle tail

#PRET
    LDE $82
    LDD $00
    JMP &TAILH &TAILL

#TAIL
    LDE $82
    RDA                 ;read value
    AA0

    LDB $00             ;if 0, ignore
    BA1
    LDF &INCTH
    LDG &INCTL
    NEQ JMR
    AA0

    D>C                 ;retreive score
    LDD $03
    LDE $81
    RDB
    BA1
    LDB $FF
    BA0
    SUB ALB
    LDE $82
    C>D

    AA0
    BA1
    LDF &DELTH
    LDG &DELTL
    NEQ JMR             ;if match, delete

    LDB $01
    BA1
    SUB
    ALA
    WRA
    
    JMP &INCTH &INCTL

#DELT
    LDB $00             ;erase tail
    LDE $82
    WRB
    LDE $80
    LDB *.
    WRB
    JMP &INCTH &INCTL

#INCT
    LDA $01             ;increment tail checking
    AA0
    DA1
    ADD
    ALD

    DA0
    LDB $00
    BA1
    LDF &RESEH
    LDG &RESEL
    NEQ JMR

    JMP &TAILH &TAILL
    
#DEAD
    LDA $0a PAA
    LDA $0a PAA
    LDA *Y PAA
    LDA *o PAA
    LDA *u PAA
    LDA $20 PAA
    LDA *d PAA
    LDA *i PAA
    LDA *e PAA
    LDA *d PAA
    LDA $0a PAA
    LDA *A PAA
    LDA *g PAA
    LDA *a PAA
    LDA *i PAA
    LDA *n PAA
    LDA *? PAA
    LDA $20 PAA
    LDA *( PAA
    LDA *y PAA
    LDA *, PAA
    LDA *n PAA
    LDA *) PAA

    JMP &ANSWH &ANSWL

#ANSW
    LDF &ANSWH
    LDG &ANSWL
    EX1 JMR

    PDA
    AA0
    LDB *y
    BA1
    LDF &CLEAH
    LDG &CLEAL
    NEQ JMR

    LDB *n
    BA1
    LDF &EXITH
    LDG &EXITL
    NEQ JMR

    JMP &ANSWH &ANSWL

#EXIT
    LDA $0a PAA
    LDA $0a PAA
    JMP $00 $00